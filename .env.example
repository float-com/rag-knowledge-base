# ===== 应用配置 =====

# 应用/服务名称：用于系统标识、日志打印标识、分布式链路追踪或服务注册
APP_NAME=rag-knowledge-base

# 日志输出级别：控制终端或日志文件中记录的信息粒度
# 可选值由低到高通常为：DEBUG < INFO < WARNING < ERROR < CRITICAL
# 生产环境通常保持 INFO，本地联调排查问题时可调整为 DEBUG
LOG_LEVEL=INFO

# 运行环境（第 13 期）：development（默认）| production
#   ★ 只有设成 production 才会启用【配置硬校验】：
#       JWT_SECRET 为空、或短于 32 字符 → 直接拒绝启动（ConfigurationError）
#       默认管理员口令仍是 admin/password/123456 → 打 ERROR 告警
#   本地开发保持 development 即可，行为与第 12 期完全一致（只告警、不阻断）。
ENVIRONMENT=development


# ===== PostgreSQL（docker-compose 与后端共用）=====

# 数据库超级用户/登录用户名：供 Docker 初始化容器及后端连接时鉴权
POSTGRES_USER=rag

# 数据库访问密码：生产环境务必替换为高强度密码
POSTGRES_PASSWORD=rag

# 默认初始化的数据库名称：用于存储当前 RAG 系统的核心业务表及向量数据
POSTGRES_DB=rag_kb

# 数据库对外暴露的主机映射端口：PostgreSQL 默认标准端口为 5432
POSTGRES_PORT=5432


# ===== 数据库连接配置 =====

# 异步数据库连接 URI：
# 格式为 postgresql+asyncpg://<用户名>:<密码>@<主机地址>:<端口>/<数据库名>
# SQLAlchemy 2.0+ 进行异步 I/O 操作时必须显式指定 asyncpg 驱动
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb

# ===== 腾讯云 COS 对象存储配置 =====

# 访问密钥 ID（SecretId）：腾讯云 CAM 访问管理的公钥标识，用于 API 请求身份认证
COS_SECRET_ID=your_cos_secret_id_here

# 访问密钥凭证（SecretKey）：腾讯云 API 请求签名私钥，具备完整管理权限，切勿提交真实私钥至公开仓库
COS_SECRET_KEY=your_cos_secret_key_here

# 存储桶所属物理机房地域代码（Region）：需与腾讯云控制台创建存储桶时所选地域保持一致
# 常见地域如：ap-guangzhou（广州）、ap-beijing（北京）、ap-shanghai（上海）
COS_REGION=ap-guangzhou

# 对象存储桶名称（Bucket）：用于持久化存储用户上传的知识库原始文档文件
# 格式规范为“自定义桶名称-APPID”，例如：rag-knowledge-1250000000
COS_BUCKET=your_bucket_name_here

# ===== 跨域资源共享 (CORS) 配置 =====
# 允许跨域请求的前端源地址列表（逗号分隔）
# 本地前端开发服务（如 Vite）默认通常运行在 5173 端口
CORS_ORIGINS=http://localhost:5173


# ===== 文本向量化配置（DashScope OpenAI 兼容协议） =====
# 阿里云百炼 API-Key，申请地址：https://bailian.console.aliyun.com/ -> API-KEY
EMBEDDING_API_KEY=your_embedding_api_key_here
# 百炼 OpenAI 兼容模式基础请求地址
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 向量模型名称
EMBEDDING_MODEL=text-embedding-v3
# 向量维度（与数据库中存储字段保持严格一致）
EMBEDDING_DIM=1024
# 单次批量向百炼 API 发送的文本切片批次大小（OpenAI 兼容协议推荐设为 16 或 32，防止单次 HTTP 请求体过大或超时）
EMBEDDING_BATCH_SIZE=16

# ===== 文档上传与切分规则配置 =====
# 最大允许上传的文件体积（MB）
UPLOAD_MAX_SIZE_MB=50
# 文档分块切片大小
CHUNK_SIZE=600
# 文档分块重叠长度
CHUNK_OVERLAP=60

# =============================================================================
# Hugging Face 模型下载镜像加速配置
# =============================================================================
# 作用说明：
# 1. 解决 Docling 解析 PDF/图片时，首次运行自动下载 OCR、版面分析及表格识别等
#    深度学习模型权重因国内网络直连 huggingface.co 导致超时或报错 (SSLError / ConnectTimeout) 的问题。
# 2. 该环境变量为 Hugging Face 官方工具链标准变量，配置后会将默认下载源透明重定向至国内镜像站。
#
# 【重要】光写在这里不够：huggingface_hub 只在 import 阶段读一次该变量，
# 而 pydantic-settings 不会把它写回进程环境。本项目由 app/core/config.py 声明字段、
# app/core/hf_env.py 注入 env、app/main.py 最先调用，才算真正生效。
HF_ENDPOINT=https://hf-mirror.com

# 模型缓存根目录：Docling 的版面分析、表格识别等权重统一落在这里，
# 便于备份、迁移与离线复用。默认值即项目根目录下的 models。
HF_HOME=D:\code\rag-knowledge-base\models

# 是否强制离线加载：true 时 huggingface_hub 不再发起任何网络请求，只用本地缓存。
# 先执行 backend/scripts/preheat_models.py 完成预热，再改为 true。
HF_HUB_OFFLINE=false

# ==============================================================================
# Chat 对话模型与 RAG 检索问答策略配置
# ==============================================================================
# 百炼 API Key（必填，若未填则无法调用模型生成回答）
CHAT_API_KEY=your_chat_api_key_here
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus

# 向量召回数量 (Top-K)
RETRIEVAL_TOP_K=5

# 检索相关度最低门槛 (0.0 ~ 1.0)，低于此值直接拒答
RETRIEVAL_MIN_SCORE=0.6

# 上下文注入的历史轮数
CHAT_HISTORY_WINDOW=5

# ==============================================================================
# Query 优化配置（第 5 期）
# ==============================================================================
# 策略路由开关：
#   true  = 开启查询优化（路由 → 改写 / HyDE / 多子查询）
#   false = 关闭，固定走 original 单路检索，整条链路退化回优化前的基线行为
# 用途：同一批提问在开 / 关两种状态下各跑一遍，对比召回分数与拒答率，
#       是度量"Query 优化到底有没有效"的第一手段。
QUERY_ROUTE_ENABLED=true

# 多查询（multi_query）策略每轮展开的子查询条数：
#   条数越多召回面越广，但每条子查询都要单独算一次向量，成本与延迟随条数线性增长。
MULTI_QUERY_COUNT=3


# ==============================================================================
# Reranker（第 8 章）
# ==============================================================================
# 关掉后 rerank 节点直接透传，作为「有 / 无精排」的对比开关
RERANK_ENABLED=true

# DashScope rerank 端点，不是标准 OpenAI API
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RERANK_MODEL=qwen3-rerank

# 留空则自动复用 CHAT_API_KEY（同一份 DashScope key）
RERANK_API_KEY=

# rerank Top1 相关度低于此阈值时拒答（qwen3-rerank score ∈ [0, 1]）
#   ⚠️ 与 RETRIEVAL_MIN_SCORE 不是同一量纲：后者比的是 embedding 余弦相似度
RERANK_MIN_SCORE=0.3

# 请求超时（秒）：rerank 是同步调用主链路，超时要短一点避免拖延回答
RERANK_TIMEOUT=8.0

# ==============================================================================
# 答案校验（第 8 章）
# ==============================================================================
# 关掉后跳过 verify_answer 调用，方便对比「有 / 无引用支撑校验」的效果
VERIFY_ANSWER_ENABLED=true


# ==============================================================================
# 认证与权限（第 11 期）
# ==============================================================================
# JWT 签名密钥：用于签发与校验登录令牌（HS256 对称签名）
#
# 【安全警示】：
#   当前为教学默认占位符（change-me...），上线前务必替换为高强度强随机串！
#   若保留默认值或留空，黑客可通过离线彩虹表暴力碰撞出密钥，进而任意伪造
#   超管身份的 JWT Token，使后端鉴权与权限隔离彻底失效。
#
# 【生成命令与实操指引】：
#   请在本地或服务器终端（Terminal / Git Bash / PowerShell）中执行下列任意一条命令：
#
#   1. 推荐（通过 OpenSSL 密码学套件生成）：
#      $ openssl rand -hex 32
#
#   2. 备选（若系统未安装 OpenSSL，可直接调 Python 原生安全库）：
#      $ python -c "import secrets; print(secrets.token_hex(32))"
#
#   【预期输出格式示例】：
#      生成内容为 32 字节（256 位熵）的高随机度 16 进制字符串，长度恰好为 64 位：
#      e.g. 41e1e65c89bc391ce4b5c178ea1640300c86cf296c67d96d3473d1b30b3c2a15
#
#   生成后将终端输出的那串 64 位字符直接复制并替换下方等号右侧的值即可。
# ==============================================================================
JWT_SECRET=change-me-please-use-a-strong-random-secret

# 签名算法：HS256 = HMAC-SHA256，单服务自签自验场景足够
JWT_ALGORITHM=HS256

# token 过期分钟数，默认 1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

# 首次启动的种子管理员：库里已有用户时自动跳过，因此可长期留在配置里
DEFAULT_ADMIN_USERNAME=admin
# ⚠️ 第 13 期改动：这里【不再给 admin 这种可直接登录的默认值】。
#   原值 admin 的后果：后端一上线就存在一个人人皆知的管理员账号。
#   注意本项只在【库内无用户】时生效 —— 若库已经建过号，改这里不会改掉已有口令，
#   必须用 SQL / 管理接口重置（部署检查单里有命令）。
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START
DEFAULT_ADMIN_DISPLAY_NAME=管理员


# ==============================================================================
# LangSmith 可观测性（第 9 期）
# ==============================================================================
# 追踪开关：
#   false = 整条链路降级（@traceable 只透传、不上报，也不下发 trace_id）
#   true  = 启用；但【必须同时填 LANGSMITH_API_KEY】，只开开关不填 key 算未启用
LANGSMITH_TRACING=true
# 在 https://smith.langchain.com 注册后，于 Settings → API Keys 创建
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
# 上报到哪个项目（LangSmith 里不存在会自动建）
LANGSMITH_PROJECT=rag-knowledge-base
# 官方服务地址：https://api.smith.langchain.com
# （专门给自托管/私有化部署留的口子，一般不用改）
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 配置后前端会展示「在 LangSmith 中查看」跳转链接；不配置则只显示复制按钮
# 格式为：https://smith.langchain.com/o/{org_id}/projects/p/{project_id}
#   ⚠️ org_id 与 project_id 都是 UUID —— project 段用【项目主键】，不是项目名
#   获取方法：打开 LangSmith → 进入项目 → 点任意一条 Run → 复制地址栏
#   复制到 /p/<uuid> 为止（不要带后面的 /r/<run_id>，也不要带 ? 后面的参数）
LANGSMITH_RUN_URL_PREFIX=https://smith.langchain.com/o/8d759a3a-6f59-4a36-bde2-dd0d8ec89565/projects/p/ed18bad7-6524-4619-b23c-4e5691b99560


# ==============================================================================
# Redis（第 12 期）：语义缓存 / 限流 / Celery broker
# ==============================================================================
# 【必须用 Redis Stack，不能用普通 Redis 镜像】
#   语义缓存要做"向量近邻检索"，而普通 redis 镜像【没有 RediSearch 模块】。
#   用普通镜像启动后，创建缓存索引时会报「未知命令 FT.CREATE」。
#   正确镜像：redis/redis-stack-server   （含 RediSearch / ReJSON / RedisBloom）
#
# 【为什么一台 Redis 要分成三个逻辑库】
#   Redis 默认提供 16 个逻辑库（db 0 ~ db 15）：同一个进程、同一块内存，
#   但【键空间完全隔离】，db 0 里的 foo 与 db 1 里的 foo 是两个互不相关的键。
#   本项目按用途分三处：应用语义缓存与限流走 db 0，Celery broker 走 db 1，
#   Celery 结果后端走 db 2 —— 互不干扰，也便于单独 FLUSHDB 清理某一类数据。
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ----- 语义缓存 -----
# 总开关：关掉后 chat 主链路完全跳过缓存查询与写入，便于对比"有/无缓存"的效果
SEMANTIC_CACHE_ENABLED=true
# 单条缓存最大存活时间（秒），默认 1 小时
#   ⚠️ TTL 是本项目目前唯一的缓存失效手段：文档权限被改后，旧答案最多存活这么久
SEMANTIC_CACHE_TTL_SECONDS=3600
# 余弦相似度阈值：query 与缓存问题语义相近到多少才算命中
#   【本项目的实测定标依据】（text-embedding-v3，中文问答，9 组样本）：
#       相近（换说法）       0.7589 ~ 0.8819
#       相关但【不同问点】   0.8381          ← 危险区：这类问题答案不同，不该命中
#       无关                0.4154 ~ 0.5161
#   可行区间是 (0.5161, 0.7589]；取 0.75 落在区间内偏严的一侧。
#   ⚠️ 教程给的 0.92 在本项目实测下【任何换说法都命中不了】——已按实测下调。
SEMANTIC_CACHE_MIN_SIMILARITY=0.75

# ----- 滑动窗口限流 -----
# 总开关：关掉后 RateLimiter 直接放行（依赖直挂，便于本地压测）
RATE_LIMIT_ENABLED=true
# 单用户每分钟最大请求数（chat / upload / reindex 共用窗口）
RATE_LIMIT_PER_MINUTE=60

